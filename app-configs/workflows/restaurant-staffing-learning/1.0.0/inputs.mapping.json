      "referenceData": [
        {
          "topic": "Scope",
          "instructions": "A bounded restaurant evidence-purchase and staffing decision, four planned study services and explicitly declared future comparable dinners."
        },
        {
          "topic": "Starting values",
          "instructions": "Prefilled values are fictional examples. Changing part of the workbook can leave example inputs in the case."
        },
        {
          "topic": "Editing",
          "instructions": "Edit the named input sheets. Keep worksheet names, column headers and record identifiers. Do not add formulas. Other case inputs remain unchanged."
        },
        {
          "topic": "Units and time",
          "instructions": "Elapsed minutes from 2026-11-13T00:00:00-06:00, America/Chicago. Study services are Nov 13, 20, 27 and Dec 4 at 18:00. Additional fictional timing premises: initial assessment Nov 13 noon, two-hour audit, trial answer Dec 5 at 21:00, commitment cutoff Dec 7 noon. Money is integer USD cents. Future operating payoffs already include runner wages; study prices are separate. Future dinner count is distinct from four study services."
        },
        {
          "topic": "Import",
          "instructions": "Upload this workbook, inspect the changes and diagnostics, then apply. Importing does not calculate results or establish operating permission."
        },
        {
          "topic": "Future dinners",
          "instructions": "Editable inputs. Only dinners still affected by the decision belong in the prospective payoff horizon."
        },
        {
          "topic": "Runner hourly rate",
          "instructions": "Editable inputs. The accepted complete hourly expense in USD cents. Trial runner expense is counted for both trial dinners."
        },
        {
          "topic": "Observer hourly rate",
          "instructions": "Editable inputs. The accepted complete hourly expense in USD cents. Observation covers all four authored dinners."
        },
        {
          "topic": "Complete three-hour dinner serv",
          "instructions": "Editable inputs. This published evidence design fixes complete service at 18:00–21:00. A different duration requires an adapted design and a new published workflow."
        },
        {
          "topic": "Use the working host as observe",
          "instructions": "Editable inputs. Using the host creates a real concurrent resource demand during the same dinner service. A free price does not establish available capacity."
        },
        {
          "topic": "Trial price complete",
          "instructions": "Editable inputs. Incomplete trial pricing prevents the paid design from being treated as a workable complete study."
        },
        {
          "topic": "Audit price complete",
          "instructions": "Editable inputs. A partial quote cannot establish the full purchase expense."
        },
        {
          "topic": "Complete audit fee",
          "instructions": "Editable inputs. The full audit price in USD cents, charged once by the learning comparison."
        },
        {
          "topic": "Study purchase authority",
          "instructions": "Editable inputs. A study purchase limit in USD cents. This is not a cash balance for future restaurant operations."
        },
        {
          "topic": "Current decision time",
          "instructions": "Editable inputs. Elapsed minutes from the authored calendar origin."
        },
        {
          "topic": "Staffing decision cutoff",
          "instructions": "Editable inputs. The usable answer and the future runner decision must arrive by this elapsed-minute cutoff."
        },
        {
          "topic": "Audit turnaround",
          "instructions": "Editable inputs. Elapsed minutes from purchase to a usable audit answer."
        },
        {
          "topic": "Trial answer time",
          "instructions": "Editable inputs. The absolute elapsed minute when the complete trial report is available."
        },
        {
          "topic": "Future runner availability",
          "instructions": "Editable inputs. A favorable report never supplies absent operating capacity."
        },
        {
          "topic": "Runner net upside per dinner",
          "instructions": "Editable inputs. Net incremental contribution after future runner wages. The complete future payoff is this amount multiplied by the number of future dinners."
        },
        {
          "topic": "Runner net downside per dinner",
          "instructions": "Editable inputs. Net incremental contribution after future runner wages, usually negative. Future wages must not be subtracted a second time."
        },
        {
          "topic": "Other staff commitments",
          "instructions": "Editable inputs. Complete recorded outside commitments remain part of every study-and-response operating check."
        },
        {
          "topic": "Explicit probability basis",
          "instructions": "Editable inputs. A stated source and exact scope for probability judgments. Evidence interpretation counts do not supply probabilities."
        },
        {
          "topic": "Prior staffing probabilities",
          "instructions": "Editable inputs. One explicit probability for each authored situation, summing to one."
        },
        {
          "topic": "Study likelihood assumptions",
          "instructions": "Editable inputs. A complete likelihood matrix for both designs, including no usable answer. These judgments remain separate from the actual evidence audit."
        },
        {
          "topic": "Report likelihoods",
          "instructions": "Editable inputs. A complete likelihood matrix for both designs, including no usable answer. These judgments remain separate from the actual evidence audit."
        },
        {
          "topic": "Optional actual report and rema",
          "instructions": "Editable inputs. Optional received records and remaining operating horizon. Receipt alone never establishes the staffing situation or authorizes a staffing change."
        }
      ]
