      "id": "read-me",
      "name": "Read me",
      "kind": "reference",
      "role": "case-worker",
      "key": [
        "topic"
      ],
      "meaning": "Instructions and sheet map. This sheet is read-only and must remain in the workbook.",
      "columns": [
        {
          "id": "topic",
          "label": "Topic",
          "type": "string",
          "nullable": false,
          "blank": "reject",
          "unit": "text"
        },
        {
          "id": "instructions",
          "label": "Instructions",
          "type": "string",
          "nullable": false,
          "blank": "reject",
          "unit": "text"
        }
      ],
      "referenceData": [
        {
          "topic": "Scope",
          "instructions": "The authored gift-kit checks and preparation arrangements within one handoff window. Supply campaign records and operating inputs; a different preparation method or rule requires adaptation."
        },
        {
          "topic": "Starting values",
          "instructions": "Prefilled values are fictional examples. Changing part of the workbook can leave example inputs in the case."
        },
        {
          "topic": "Editing",
          "instructions": "Edit the named input sheets. Keep worksheet names, column headers and record identifiers. Do not add formulas. Other case inputs remain unchanged."
        },
        {
          "topic": "Units and time",
          "instructions": "Use the declared time unit and origin. Relative deadlines and durations are not calendar dates. Dollar figures use the declared currency scale."
        },
        {
          "topic": "Import",
          "instructions": "Upload this workbook, inspect the changes and diagnostics, then apply. Importing does not calculate results or establish operating permission."
        },
        {
          "topic": "Review reference",
          "instructions": "Editable inputs. Identify this review independently from its batch and exact configuration."
        },
        {
          "topic": "Exact gift-kit configuration",
          "instructions": "Editable inputs. Reports and permissions must match this exact six-field scope. Revising it requires reassessing the evidence."
        },
        {
          "topic": "Kit quantity, cutoff and expens",
          "instructions": "Editable inputs. Times are minutes from one declared review origin. Quotes cover the complete kit quantity; amounts are USD cents. Quantity does not silently scale quoted work."
        },
        {
          "topic": "Actual reports",
          "instructions": "Editable inputs. Retain exact configuration, observation time, recorder and original source text. The initial broad rehearsal failure does not mean a printed code was unreadable: record only the stated diagnostic result. This profile assumes accurate current scoped reports. Planned or simulated checks are not observations."
        },
        {
          "topic": "Correction quotes",
          "instructions": "Editable inputs. Supply every published package quote for this batch. Frozen package effects and task dependencies cannot be edited through quotes."
        },
        {
          "topic": "Fresh rehearsal duration",
          "instructions": "Editable inputs. Reserve the complete fresh rehearsal duration, subject to the published minimum. Scheduling it does not establish a passing result."
        },
        {
          "topic": "Handoff duration",
          "instructions": "Editable inputs. Reserve the complete final handoff duration after correction and rehearsal. A calculated finish does not record actual handoff."
        },
        {
          "topic": "Person responsible for the work",
          "instructions": "Editable inputs. The same recorded person performs the three sequential activities in this bounded profile. Declared responsibility is not authenticated identity."
        },
        {
          "topic": "Responsible people",
          "instructions": "Editable inputs. A person must be recorded before assignment. Permission is supplied and checked separately."
        },
        {
          "topic": "Production resources",
          "instructions": "Editable inputs. Available intervals and capacity constrain correction, rehearsal and handoff. This profile has no other booked work or concurrent campaigns."
        },
        {
          "topic": "Recorded permissions",
          "instructions": "Editable inputs. The supplied register is stipulated complete. Each permission must match the exact configuration, person and package and cover the full work interval; an empty register supplies no permission."
        },
        {
          "topic": "Recorded package confirmations",
          "instructions": "Editable inputs. Keep the original source and recorder, exact package and six-field configuration, positive or negative status, observation time and validity interval. Empty records establish no confirmation. A confirmation does not replace operating permission or completed correction evidence."
        }
      ]
    },
